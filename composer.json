{
  "name": "arraypress/wp-register-flyouts",
  "description": "Lightweight flyout panels for WordPress admin interfaces",
  "type": "library",
  "license": "GPL-2.0-or-later",
  "homepage": "https://github.com/arraypress/wp-flyout/",
  "authors": [
    {
      "name": "David Sherlock",
      "homepage": "https://arraypress.com/"
    }
  ],
  "require": {
    "php": ">=8.3",
    "arraypress/wp-composer-assets": "dev-main",
    "arraypress/wp-currencies": "dev-main",
    "arraypress/wp-field-kit": "dev-main"
  },
  "autoload": {
    "psr-4": {
      "ArrayPress\\RegisterFlyouts\\": "src/"
    },
    "files": [
      "src/Functions.php"
    ]
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "keywords": [
    "wordpress",
    "flyout",
    "panel",
    "admin",
    "ui"
  ],
  "require-dev": {
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "phpunit/phpunit": "^12.0",
    "squizlabs/php_codesniffer": "^3.13.5",
    "wp-coding-standards/wpcs": "^3.4"
  },
  "autoload-dev": {
    "psr-4": {
      "ArrayPress\\RegisterFlyouts\\Tests\\": "tests/"
    },
    "exclude-from-classmap": [
      "/tests/bootstrap.php"
    ]
  },
  "scripts": {
    "test": "phpunit",
    "lint": "phpcs",
    "format": "phpcbf --standard=phpcs-format.xml.dist",
    "format:check": "phpcs --standard=phpcs-format.xml.dist",
    "docs:verify": "php vendor/arraypress/wp-field-kit/bin/verify-docs.php --calls=register_flyout --types=header,info_grid README.md $(find docs -name '*.md')"
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/arraypress/wp-field-kit.git"
    }
  ]
}
